ENV="local" # can be local, dev, test, staging, prod
PORT="5050" # the port at which the server will run

# database
PRIMARY_DB_URL="<whatever>"
REPLICA_DB_URLS="<whatever>"

# cache
CACHE_URL="<whatever>"
CACHE_PASSWORD="<whatever>"
CACHE_DATABASE="<whatever>" # the database index
CACHE_SYSTEM_PREFIX="<whatever>" # always attach this when creating keys

# cors
ALLOWED_ORIGINS="*" # don't forget to limit

# base url
SELF_BASE_URL="http://0.0.0.0:5050" # the url this api will be accessed at