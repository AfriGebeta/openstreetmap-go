{{define "oauth-2-login-ui"}}
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Mahtem</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
        <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/ajax@3.x.x/dist/cdn.min.js"></script>
        <script>
            tailwind.config = {
                theme: {
                    extend: {
                        animation: {
                            'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                            'fade-in': 'fadeIn 0.3s ease-in-out'
                        },
                        keyframes: {
                            fadeIn: {
                                '0%': { opacity: '0', transform: 'translateY(10px)' },
                                '100%': { opacity: '1', transform: 'translateY(0)' }
                            }
                        }
                    }
                }
            }
        </script>
        <style>
            .gradient-bg {
                background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
            }
            .glass-card {
                background: rgba(255, 255, 255, 0.95);
                backdrop-filter: blur(10px);
            }
            .dot-pattern {
                background-image: radial-gradient(circle, #10b981 1px, transparent 1px);
                background-size: 8px 8px;
            }
            .gradient-button {
                background: linear-gradient(135deg, #10b981 0%, #0d9488 100%);
            }
            .gradient-button:hover {
                background: linear-gradient(135deg, #059669 0%, #0f766e 100%);
            }
        </style>
    </head>
    <body class="gradient-bg min-h-screen relative overflow-hidden" x-data="oauthApp()">
    <!-- Decorative elements -->
    <div class="absolute top-0 left-0 w-32 h-32 opacity-20 dot-pattern"></div>
    <div class="absolute bottom-0 right-0 w-32 h-32 opacity-20 dot-pattern"></div>

    <!-- Loading Overlay -->
    <div x-show="loading" x-transition class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
        <div class="bg-white rounded-lg p-6 flex items-center space-x-3">
            <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-emerald-500"></div>
            <span class="text-gray-700">Processing...</span>
        </div>
    </div>

    <!-- Header -->
    <header>
        <div class="absolute top-4 left-4 flex items-center space-x-2">
            <div class="w-8 h-8 bg-emerald-500 rounded-full flex items-center justify-center">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
            </div>
            <span class="text-white font-semibold">SecureAuth</span>
        </div>

        <div class="absolute top-4 right-4">
            <select class="bg-slate-700 border-slate-600 text-white rounded px-3 py-1 text-sm">
                <option value="en">English</option>
                <option value="es">Español</option>
            </select>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex items-center justify-center min-h-screen p-4">
        <div class="w-full max-w-md glass-card shadow-2xl rounded-xl border border-white/20">
            <!-- Header -->
            <div class="text-center p-6 pb-4">
                <h1 class="text-2xl font-bold text-slate-800" x-text="getStepTitle()"></h1>
                <p class="text-slate-600 text-sm mt-1" x-show="step === 'login'" x-text="`Please enter your ${loginType === 'tin' ? 'TIN' : 'License Number'}`"></p>
            </div>

            <div class="px-6 pb-6 space-y-6">
                <!-- Login Step -->
                <div x-show="step === 'login'" x-transition.opacity class="animate-fade-in">
                    <!-- Logo Section -->
                    <div class="flex justify-center mb-6">
                        <div class="flex items-center space-x-4">
                            <div class="w-16 h-16 bg-gradient-to-r from-amber-400 to-orange-500 rounded-full flex items-center justify-center">
                                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                </svg>
                            </div>
                            <div class="flex flex-col items-center">
                                <div class="w-8 border-t-2 border-slate-300 mb-2"></div>
                                <div class="w-8 border-t-2 border-slate-300"></div>
                            </div>
                            <div class="w-16 h-16 bg-gradient-to-r from-emerald-500 to-teal-600 rounded-full flex items-center justify-center">
                                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <!-- Login Type Toggle -->
                        <div class="flex space-x-2">
                            <button
                                    @click="setLoginType('tin')"
                                    :class="loginType === 'tin' ? 'gradient-button text-white' : 'bg-white border border-slate-300 text-slate-700 hover:bg-slate-50'"
                                    class="flex-1 py-2 px-4 rounded-md font-medium transition-all duration-200"
                            >
                                TIN
                            </button>
                            <button
                                    @click="setLoginType('license')"
                                    :class="loginType === 'license' ? 'gradient-button text-white' : 'bg-white border border-slate-300 text-slate-700 hover:bg-slate-50'"
                                    class="flex-1 py-2 px-4 rounded-md font-medium transition-all duration-200"
                            >
                                License No.
                            </button>
                        </div>

                        <!-- Input Field -->
                        <div class="space-y-2">
                            <label class="flex items-center space-x-1 text-sm font-medium text-slate-700">
                                <span x-text="loginType === 'tin' ? 'TIN' : 'License Number'"></span>
                                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </label>
                            <input
                                    type="text"
                                    x-model="tinOrLicense"
                                    :placeholder="`Enter your ${loginType === 'tin' ? 'TIN' : 'License Number'}`"
                                    class="w-full px-4 py-3 border border-slate-300 rounded-md text-center text-lg tracking-wider focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition-all duration-200"
                            />
                        </div>

                        <!-- Error Message -->
                        <div x-show="errorMessage" x-transition class="text-red-600 text-sm text-center" x-text="errorMessage"></div>

                        <button
                                @click="handleLogin()"
                                :disabled="!tinOrLicense || loading"
                                :class="tinOrLicense && !loading ? 'gradient-button hover:shadow-lg' : 'bg-slate-300 cursor-not-allowed'"
                                class="w-full py-3 text-white font-medium rounded-md transition-all duration-200"
                        >
                            <span x-show="!loading">Get OTP</span>
                            <span x-show="loading" class="flex items-center justify-center">
                                <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white mr-2"></div>
                                Loading...
                            </span>
                        </button>
                    </div>
                </div>

                <!-- Business Select Step -->
                <div x-show="step === 'business-select'" x-transition.opacity class="animate-fade-in">
                    <div class="flex items-center space-x-2 mb-4">
                        <button @click="step = 'login'" class="text-slate-600 hover:text-slate-800 flex items-center space-x-1">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                            </svg>
                            <span class="text-sm">Back to login</span>
                        </button>
                    </div>

                    <div class="space-y-4">
                        <div class="text-center">
                            <svg class="w-12 h-12 text-emerald-500 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                            </svg>
                            <p class="text-slate-600">Select your business to continue</p>
                        </div>

                        <div class="space-y-2">
                            <label class="text-sm font-medium text-slate-700">Business</label>
                            <select
                                    x-model="selectedBusiness"
                                    class="w-full px-4 py-3 border border-slate-300 rounded-md focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none"
                            >
                                <option value="">Choose your business</option>
                                <template x-for="business in businesses" :key="business.id">
                                    <option :value="business.id" x-text="`${business.name} - ${business.licenseNo}`"></option>
                                </template>
                            </select>
                        </div>

                        <button
                                @click="handleBusinessSelect()"
                                :disabled="!selectedBusiness || loading"
                                :class="selectedBusiness && !loading ? 'gradient-button hover:shadow-lg' : 'bg-slate-300 cursor-not-allowed'"
                                class="w-full py-3 text-white font-medium rounded-md transition-all duration-200"
                        >
                            Continue
                        </button>
                    </div>
                </div>

                <!-- OTP Step -->
                <div x-show="step === 'otp'" x-transition.opacity class="animate-fade-in">
                    <div class="flex items-center space-x-2 mb-4">
                        <button @click="goBack()" class="text-slate-600 hover:text-slate-800 flex items-center space-x-1">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                            </svg>
                            <span class="text-sm">Back</span>
                        </button>
                    </div>

                    <div class="space-y-6">
                        <div class="text-center">
                            <svg class="w-12 h-12 text-emerald-500 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                            </svg>
                            <p class="text-slate-600 text-sm">OTP has been sent to your registered Mobile Number:</p>
                            <p class="font-mono text-slate-800">XXXXXX1582</p>
                        </div>

                        <div class="space-y-4">
                            <label class="text-center block text-sm font-medium text-slate-700">Enter OTP</label>
                            <div class="flex justify-center space-x-2">
                                <template x-for="i in 6" :key="i">
                                    <input
                                            type="text"
                                            maxlength="1"
                                            :x-ref="`otp${i-1}`"
                                            @input="handleOtpInput($event, i-1)"
                                            @keydown="handleOtpKeydown($event, i-1)"
                                            class="w-12 h-12 border border-slate-300 rounded-md text-center text-xl font-bold focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none"
                                    />
                                </template>
                            </div>
                        </div>

                        <!-- Error Message -->
                        <div x-show="errorMessage" x-transition class="text-red-600 text-sm text-center" x-text="errorMessage"></div>

                        <button
                                @click="handleOtpVerify()"
                                :disabled="otp.length !== 6 || loading"
                                :class="otp.length === 6 && !loading ? 'gradient-button hover:shadow-lg' : 'bg-slate-300 cursor-not-allowed'"
                                class="w-full py-3 text-white font-medium rounded-md transition-all duration-200"
                        >
                            <span x-show="!loading">Verify</span>
                            <span x-show="loading" class="flex items-center justify-center">
                                <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white mr-2"></div>
                                Verifying...
                            </span>
                        </button>

                        <div class="text-center">
                            <p class="text-sm text-slate-600" x-text="`Resend OTP in ${Math.floor(otpTimer / 60)}:${(otpTimer % 60).toString().padStart(2, '0')}`"></p>
                            <button
                                    x-show="otpTimer === 0"
                                    @click="resendOtp()"
                                    class="text-emerald-600 hover:text-emerald-700 text-sm font-medium mt-2"
                            >
                                Resend OTP
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Consent Step -->
                <div x-show="step === 'consent'" x-transition.opacity class="animate-fade-in">
                    <div class="space-y-6">
                        <div class="text-center">
                            <svg class="w-12 h-12 text-emerald-500 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                            </svg>
                            <h3 class="font-semibold text-slate-800">Data Sharing Consent</h3>
                            <p class="text-sm text-slate-600">
                                Please review and consent to share the following data with the requesting application
                            </p>
                        </div>

                        <div class="space-y-4">
                            <!-- Basic Info -->
                            <div class="flex items-start space-x-3">
                                <input
                                        type="checkbox"
                                        id="basicInfo"
                                        x-model="consentItems.basicInfo"
                                        class="mt-1 w-4 h-4 text-emerald-600 border-slate-300 rounded focus:ring-emerald-500"
                                />
                                <div class="space-y-1">
                                    <label for="basicInfo" class="flex items-center space-x-2 text-sm font-medium text-slate-700">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                        </svg>
                                        <span>Basic Information</span>
                                    </label>
                                    <p class="text-xs text-slate-500">Name, ID, registration details</p>
                                </div>
                            </div>

                            <!-- Business Info -->
                            <div class="flex items-start space-x-3">
                                <input
                                        type="checkbox"
                                        id="businessInfo"
                                        x-model="consentItems.businessInfo"
                                        class="mt-1 w-4 h-4 text-emerald-600 border-slate-300 rounded focus:ring-emerald-500"
                                />
                                <div class="space-y-1">
                                    <label for="businessInfo" class="flex items-center space-x-2 text-sm font-medium text-slate-700">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                                        </svg>
                                        <span>Business Information</span>
                                    </label>
                                    <p class="text-xs text-slate-500">Company details, license information</p>
                                </div>
                            </div>

                            <!-- Contact Info -->
                            <div class="flex items-start space-x-3">
                                <input
                                        type="checkbox"
                                        id="contactInfo"
                                        x-model="consentItems.contactInfo"
                                        class="mt-1 w-4 h-4 text-emerald-600 border-slate-300 rounded focus:ring-emerald-500"
                                />
                                <div class="space-y-1">
                                    <label for="contactInfo" class="flex items-center space-x-2 text-sm font-medium text-slate-700">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                                        </svg>
                                        <span>Contact Information</span>
                                    </label>
                                    <p class="text-xs text-slate-500">Email, phone number, address</p>
                                </div>
                            </div>

                            <!-- Financial Data -->
                            <div class="flex items-start space-x-3">
                                <input
                                        type="checkbox"
                                        id="financialData"
                                        x-model="consentItems.financialData"
                                        class="mt-1 w-4 h-4 text-emerald-600 border-slate-300 rounded focus:ring-emerald-500"
                                />
                                <div class="space-y-1">
                                    <label for="financialData" class="flex items-center space-x-2 text-sm font-medium text-slate-700">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                                        </svg>
                                        <span>Financial Data</span>
                                    </label>
                                    <p class="text-xs text-slate-500">Tax information, financial records</p>
                                </div>
                            </div>
                        </div>

                        <div class="flex space-x-3">
                            <button
                                    @click="step = 'otp'"
                                    class="flex-1 py-3 bg-white border border-slate-300 text-slate-700 font-medium rounded-md hover:bg-slate-50 transition-all duration-200"
                            >
                                Cancel
                            </button>
                            <button
                                    @click="handleConsent()"
                                    :disabled="!allConsentChecked || loading"
                                    :class="allConsentChecked && !loading ? 'gradient-button hover:shadow-lg' : 'bg-slate-300 cursor-not-allowed'"
                                    class="flex-1 py-3 text-white font-medium rounded-md transition-all duration-200"
                            >
                                <span x-show="!loading">Authorize</span>
                                <span x-show="loading" class="flex items-center justify-center">
                                    <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white mr-2"></div>
                                    Authorizing...
                                </span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="absolute bottom-4 left-1/2 transform -translate-x-1/2">
        <div class="flex items-center space-x-2 text-white/70 text-sm">
            <span>Powered by</span>
            <div class="flex items-center space-x-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
                <span class="font-semibold">SecureAuth</span>
            </div>
        </div>
    </footer>

    <script>
        function oauthApp() {
            return {
                step: 'login',
                loginType: 'tin',
                tinOrLicense: '',
                selectedBusiness: '',
                otp: '',
                otpTimer: 120,
                loading: false,
                errorMessage: '',
                consentItems: {
                    basicInfo: false,
                    businessInfo: false,
                    contactInfo: false,
                    financialData: false
                },
                businesses: [
                    { id: '1', name: 'Tech Solutions Ltd.', licenseNo: 'LIC001234' },
                    { id: '2', name: 'Digital Services Inc.', licenseNo: 'LIC005678' },
                    { id: '3', name: 'Innovation Hub Co.', licenseNo: 'LIC009012' }
                ],

                init() {
                    this.startOtpTimer();
                },

                getStepTitle() {
                    const titles = {
                        'login': 'Login',
                        'business-select': 'Select Business',
                        'otp': 'Verify OTP',
                        'consent': 'Data Consent'
                    };
                    return titles[this.step];
                },

                setLoginType(type) {
                    this.loginType = type;
                    this.errorMessage = '';
                },

                async handleLogin() {
                    if (!this.tinOrLicense) return;

                    this.loading = true;
                    this.errorMessage = '';

                    try {
                        // Simulate API call with Alpine AJAX
                        await this.simulateApiCall('/api/validate-identifier', {
                            type: this.loginType,
                            identifier: this.tinOrLicense
                        });

                        if (this.loginType === 'tin') {
                            this.step = 'business-select';
                        } else {
                            this.step = 'otp';
                            this.resetOtpTimer();
                        }
                    } catch (error) {
                        this.errorMessage = 'Invalid ' + (this.loginType === 'tin' ? 'TIN' : 'License Number') + '. Please try again.';
                    } finally {
                        this.loading = false;
                    }
                },

                async handleBusinessSelect() {
                    if (!this.selectedBusiness) return;

                    this.loading = true;

                    try {
                        await this.simulateApiCall('/api/select-business', {
                            businessId: this.selectedBusiness
                        });

                        this.step = 'otp';
                        this.resetOtpTimer();
                    } catch (error) {
                        this.errorMessage = 'Failed to select business. Please try again.';
                    } finally {
                        this.loading = false;
                    }
                },

                handleOtpInput(event, index) {
                    const value = event.target.value;
                    if (!/^\d$/.test(value) && value !== '') {
                        event.target.value = '';
                        return;
                    }

                    let otpArray = this.otp.split('');
                    otpArray[index] = value;
                    this.otp = otpArray.join('').slice(0, 6);

                    if (value && index < 5) {
                        this.$refs[`otp${index + 1}`].focus();
                    }

                    this.errorMessage = '';
                },

                handleOtpKeydown(event, index) {
                    if (event.key === 'Backspace' && !event.target.value && index > 0) {
                        this.$refs[`otp${index - 1}`].focus();
                    }
                },

                async handleOtpVerify() {
                    if (this.otp.length !== 6) return;

                    this.loading = true;
                    this.errorMessage = '';

                    try {
                        await this.simulateApiCall('/api/verify-otp', {
                            otp: this.otp
                        });

                        this.step = 'consent';
                    } catch (error) {
                        this.errorMessage = 'Invalid OTP. Please try again.';
                        this.otp = '';
                        // Clear all OTP inputs
                        for (let i = 0; i < 6; i++) {
                            this.$refs[`otp${i}`].value = '';
                        }
                        this.$refs['otp0'].focus();
                    } finally {
                        this.loading = false;
                    }
                },

                async handleConsent() {
                    if (!this.allConsentChecked) return;

                    this.loading = true;

                    try {
                        const response = await this.simulateApiCall('/api/authorize', {
                            consent: this.consentItems,
                            identifier: this.tinOrLicense,
                            business: this.selectedBusiness
                        });

                        // Generate authorization code and redirect
                        const authCode = 'auth_' + Math.random().toString(36).substr(2, 9);
                        const redirectUrl = 'https://partner-app.com/callback';

                        alert(`Authorization successful!\nCode: ${authCode}\n\nRedirecting to: ${redirectUrl}?code=${authCode}&state=oauth_state`);

                        // In real implementation, redirect to partner's callback URL
                        // window.location.href = `${redirectUrl}?code=${authCode}&state=oauth_state`;

                    } catch (error) {
                        this.errorMessage = 'Authorization failed. Please try again.';
                    } finally {
                        this.loading = false;
                    }
                },

                goBack() {
                    if (this.step === 'otp') {
                        this.step = this.loginType === 'tin' ? 'business-select' : 'login';
                    }
                },

                async resendOtp() {
                    this.loading = true;

                    try {
                        await this.simulateApiCall('/api/resend-otp', {
                            identifier: this.tinOrLicense
                        });

                        this.resetOtpTimer();
                        alert('OTP has been resent to your registered mobile number.');
                    } catch (error) {
                        this.errorMessage = 'Failed to resend OTP. Please try again.';
                    } finally {
                        this.loading = false;
                    }
                },

                startOtpTimer() {
                    setInterval(() => {
                        if (this.otpTimer > 0) {
                            this.otpTimer--;
                        }
                    }, 1000);
                },

                resetOtpTimer() {
                    this.otpTimer = 120;
                },

                // Simulate API calls (replace with real Alpine AJAX calls)
                async simulateApiCall(url, data) {
                    return new Promise((resolve, reject) => {
                        setTimeout(() => {
                            // Simulate random success/failure for demo
                            if (Math.random() > 0.1) { // 90% success rate
                                resolve({ success: true, data: data });
                            } else {
                                reject(new Error('API Error'));
                            }
                        }, 1000 + Math.random() * 1000); // 1-2 second delay
                    });
                },

                get allConsentChecked() {
                    return Object.values(this.consentItems).every(Boolean);
                }
            }
        }
    </script>
    </body>
    </html>
{{end}}
